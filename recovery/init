#!/bin/sh
export PATH=/usr/bin:/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /run /tmp /mnt
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0700 tmpfs /run
mount -t tmpfs -o mode=1777 tmpfs /tmp
modprobe virtio_pci
modprobe virtio_blk
modprobe ext4
modprobe vfat
modprobe nls_cp437
modprobe nls_iso8859_1
printf '\nNyx Backup offline recovery\n'
printf 'No disks are mounted or changed automatically. Networking is not configured.\n'
printf 'Use nyx-backup-recovery --help and /RECOVERY.md.\n'
printf 'Mount separate repository and scratch storage yourself.\n'
# This script is PID 1: if it ended, the kernel would panic and reboot without
# writing out the storage mounted during recovery.
while :; do
	setsid cttyhack sh
	printf '\nType "poweroff" to sync, unmount and power off, or press Enter for a new shell: '
	read -r answer || answer=poweroff
	if [ "$answer" = poweroff ]; then
		sync
		umount -a -r 2>/dev/null
		sync
		poweroff -f
	fi
done
